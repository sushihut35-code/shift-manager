// シフト管理アプリ Prisma Schema（Supabase PostgreSQL）

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// スタッフマスタ
model Staff {
  id           String   @id @default(uuid())
  name         String
  displayColor String   @default("#6B7280") @map("display_color")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  memo         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shifts Shift[]

  @@map("staffs")
  @@index([sortOrder])
}

// シフト（スタッフ×日で複数行可。1行=1時間帯、または休み行）
// date は "YYYY-MM-DD"、start/end は "HH:mm" の文字列で保持（TZ起因の日付ずれを構造的に回避）
model Shift {
  id        String   @id @default(uuid())
  staffId   String   @map("staff_id")
  date      String   @db.VarChar(10)
  startTime String?  @map("start_time") @db.Char(5) // 時間帯シフトでは必須・休み行では null
  endTime   String?  @map("end_time") @db.Char(5)
  isDayOff  Boolean  @default(false) @map("is_day_off")
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("shifts")
  @@index([staffId, date])
  @@index([date])
}
